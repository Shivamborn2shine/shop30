    <!-- ========================================================================= -->
    <!-- JAVASCRIPT LOGIC & ENGINES                                                -->
    <!-- ========================================================================= -->
    <script>
        /* -------------------------------------------------------------------------
         * 1. STORE CONFIGURATION (Official Details from Vice City)
         * ------------------------------------------------------------------------- */
        const STORE_CONFIG = window.STORE_CONFIG = {
            id: "vice-city-dehradun",
            name: "VICE CITY",
