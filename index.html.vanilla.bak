            tagline: "Export Surplus Brand, Boys & Girls Wear",
            categorySubtitle: "International Brands Readymade Garments",
            address: "Shop no. 30, Rajpur Road, Indira Market, Dehradun, Uttarakhand 248001",
            
            contact: {
                phone: "+919760441031",
                phoneDisplay: "97604 41031",
                whatsapp: "919760441031",
                mapsUrl: "https://www.google.com/maps?cid=5001663107305836739"
            },

            // WhatsApp Business Catalogue: Marked as Coming Soon per user request
            whatsappCatalogueStatus: "COMING_SOON",
            whatsappCatalogueUrl: "", // Reserved for future WhatsApp catalogue link

            reviews: {
                writeReviewUrl: "https://search.google.com/local/writereview?placeid=ChIJ_ejfCQApCTkRwxAknRh6aUU",
                placeId: "ChIJ_ejfCQApCTkRwxAknRh6aUU",
                cid: "5001663107305836739",
                rating: 4.9,
                count: "250+"
            },

