                googleMapsUrl: "https://www.google.com/maps?cid=5001663107305836739",
                instagramUrl: "https://www.instagram.com/"
            }
        };

        /* -------------------------------------------------------------------------
         * 2. APPAREL CATALOG & HIGHLIGHT LIBRARY (Reflecting Vice City Stock)
         * ------------------------------------------------------------------------- */
        const APPAREL_CATALOG = [
            // Outerwear & Jackets
            { name: "Leather Biker Jacket", category: "OUTERWEAR", icon: "🧥", defaultPicked: true },
            { name: "Monogram Puffer Jacket", category: "OUTERWEAR", icon: "🧥", defaultPicked: true },
            { name: "Distressed Zip Jacket", category: "OUTERWEAR", icon: "🧥" },
            { name: "Checkered Fleece Zip-Up", category: "OUTERWEAR", icon: "🧥" },
            { name: "Corduroy Overshirt", category: "OUTERWEAR", icon: "🧥" },
            { name: "Toggle Closure Jacket", category: "OUTERWEAR", icon: "🧥" },

            // Tops & Sweatshirts
            { name: "Pink Graphic Sweatshirt", category: "TOPS", icon: "👕", defaultPicked: true },
            { name: "Export Surplus Branded Tee", category: "TOPS", icon: "👕" },
            { name: "Acid Wash Street Tee", category: "TOPS", icon: "👕" },
            { name: "Heavyweight Boxy Hoodie", category: "TOPS", icon: "👕" },
            { name: "Drop-Shoulder Street Tee", category: "TOPS", icon: "👕" },

            // Bottoms & Denims
            { name: "International Brand Jeans", category: "BOTTOMS", icon: "👖", defaultPicked: true },
            { name: "Baggy Utility Cargos", category: "BOTTOMS", icon: "👖" },
            { name: "Relaxed Track Pants", category: "BOTTOMS", icon: "👖" },
            { name: "Stacked Denim Jeans", category: "BOTTOMS", icon: "👖" },

            // Girls Wear
            { name: "Girls Streetwear Hoodies", category: "GIRLS", icon: "✨" },
            { name: "Girls Oversized Tops", category: "GIRLS", icon: "✨" },
            { name: "Girls Flared Denims", category: "GIRLS", icon: "✨" },
            { name: "Girls Winter Crop Jackets", category: "GIRLS", icon: "✨" }
        ];

        const APPAREL_HIGHLIGHT_LIBRARY = {
            "Leather Biker Jacket": {
                title: "Leather Jacket Highlights",
                icon: "🧥",
                highlights: [
                    "Solid Hardware & Heavy Zippers",
                    "Authentic Textured Leather Feel",
                    "Structured Shoulder Cut",
                    "Warm Inner Lining",
                    "Great Value Compared to Retail",
                    "Timeless Biker Aesthetic"
                ]
            },
            "Monogram Puffer Jacket": {
                title: "Monogram Puffer Highlights",
                icon: "🧥",
                highlights: [
                    "Super Warm & Insulated",
                    "Luxury Monogram Pattern",
                    "Comfortable High Collar",
                    "High Quality Outer Shell",
                    "Perfect for Dehradun Winters"
                ]
            },
            "Distressed Zip Jacket": {
                title: "Distressed Jacket Highlights",
                icon: "🧥",
                highlights: [
                    "Heavyweight Fabric",
                    "Authentic Distressed Wash",
                    "Sturdy Metal Zipper",
                    "Trendy Streetwear Fit"
                ]
            },
            "Corduroy Overshirt": {
                title: "Corduroy Shacket Highlights",
                icon: "🧥",
                highlights: [
                    "Soft Ribbed Corduroy",
                    "Versatile Layering Piece",
                    "Durable Buttons",
                    "Clean Stitching & Cut"
                ]
            },
            "Pink Graphic Sweatshirt": {
                title: "Graphic Sweatshirt Highlights",
                icon: "👕",
                highlights: [
                    "Cozy Fleece Interior",
                    "Vibrant Streetwear Print",
                    "Relaxed Drop Shoulder",
                    "Durable Ribbed Hem & Cuffs",
                    "Great for Both Boys & Girls"
                ]
            },
            "Export Surplus Branded Tee": {
                title: "Export Surplus Tee Highlights",
                icon: "👕",
                highlights: [
                    "100% Combed Heavy Cotton",
                    "Original International Brand Tagging",
                    "Color Doesn't Fade After Wash",
                    "Comfortable Collar Fit",
                    "Fraction of Original Showroom Price"
                ]
            },
            "International Brand Jeans": {
                title: "Denims Highlights",
                icon: "👖",
                highlights: [
                    "Substantial Denim Weight",
                    "Authentic Brand Wash",
                    "Comfortable Waist Fit",
                    "Durable Rivets & Stitching",
                    "Great Baggy / Straight Cut"
                ]
            },
            "Baggy Utility Cargos": {
                title: "Utility Cargos Highlights",
                icon: "👖",
                highlights: [
                    "Functional Deep Pockets",
                    "Perfect Ankle Stacking",
                    "Heavy Cotton Twill",
                    "Comfortable All-Day Wear"
                ]
            }
        };

        // Universal Shopping Highlights for Indira Market Store Visit
        const UNIVERSAL_STORE_HIGHLIGHTS = [
            "Chill & Helpful Staff",
            "Zero Pushy Sales Pressure",
            "Huge Variety of International Brands",
            "Best Surplus Rates in Indira Market",
            "Clean Garment Racks",
            "Spacious Trial Room Facility",
            "Both Boys & Girls Wear Available",
            "Will Definitely Shop Again"
        ];

        /* -------------------------------------------------------------------------
         * 3. STATE MANAGEMENT
         * ------------------------------------------------------------------------- */
        let userIntent = "BOUGHT";
        let confirmedServicesList = ["Leather Biker Jacket", "Export Surplus Branded Tee"];
        let modalSelectedList = ["Leather Biker Jacket", "Export Surplus Branded Tee"];
        let selectedHighlightsMap = {};
        let currentReviewLength = "SHORT";
        let currentReviewLang = "ENGLISH";
        let customerWrittenReviewNotes = "";
        let typewriterTimeout = null;
        let searchTypewriterIndex = 0;
        let searchTypewriterTimer = null;

        /* -------------------------------------------------------------------------
         * 4. INITIALIZATION & LEATHER JACKET INTRO ANIMATION
         * ------------------------------------------------------------------------- */
        document.addEventListener('DOMContentLoaded', () => {
            initJacketOpeningAnimation();
            renderApparelChipsGrid('ALL');
            renderConfirmedServicesBar();
            renderDynamicGroupedHighlights();
            renderTestimonialsMarquee();
            renderFAQs();
            initCustomerNotesCounter();

            const hasSeenIntro = sessionStorage.getItem('vicecity_intro_seen');
            const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            if (prefersReducedMotion || hasSeenIntro) {
                instantBypassJacketIntro();
            }
        });

        function initJacketOpeningAnimation() {
            window.jacketAutoTimer = setTimeout(() => {
                triggerJacketUnzip();
            }, 1200);
        }

        function triggerJacketUnzip() {
            if (window.jacketUnzipped) return;
            window.jacketUnzipped = true;
            clearTimeout(window.jacketAutoTimer);

            const overlay = document.getElementById('jacketIntroOverlay');
            const leftFlap = document.getElementById('jacketLeftFlap');
            const rightFlap = document.getElementById('jacketRightFlap');
            const zipperPull = document.getElementById('zipperSliderPull');
            const underglow = document.getElementById('jacketUnderglow');
            const tapHint = document.getElementById('jacketTapHint');

            if (tapHint) tapHint.style.opacity = '0';
            if (underglow) underglow.style.opacity = '1';

            if (zipperPull) zipperPull.classList.add('zipper-pull-down');

            setTimeout(() => {
                if (leftFlap) leftFlap.classList.add('jacket-unzipped-left');
                if (rightFlap) rightFlap.classList.add('jacket-unzipped-right');
            }, 180);

            setTimeout(() => {
                if (overlay) {
                    overlay.style.opacity = '0';
                    overlay.style.pointerEvents = 'none';
                }
                sessionStorage.setItem('vicecity_intro_seen', 'true');

                if (!sessionStorage.getItem('vicecity_intent_chosen')) {
                    setTimeout(openInitialIntentModal, 250);
                }
            }, 850);
        }

        function skipJacketIntro() {
            clearTimeout(window.jacketAutoTimer);
            instantBypassJacketIntro();
            if (!sessionStorage.getItem('vicecity_intent_chosen')) {
                setTimeout(openInitialIntentModal, 250);
            }
        }

        function instantBypassJacketIntro() {
            const overlay = document.getElementById('jacketIntroOverlay');
            if (overlay) {
                overlay.style.display = 'none';
            }
            sessionStorage.setItem('vicecity_intro_seen', 'true');
        }

        function replayJacketIntro() {
            sessionStorage.removeItem('vicecity_intro_seen');
            window.location.reload();
        }

        /* -------------------------------------------------------------------------
         * 5. INTENT FOCUS MODAL (STEP 1)
         * ------------------------------------------------------------------------- */
        function openInitialIntentModal() {
            const modal = document.getElementById('entryFocusModal');
            if (!modal) return;
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modal.classList.add('opacity-100');
        }

        function closeInitialIntentModal() {
            const modal = document.getElementById('entryFocusModal');
            if (!modal) return;
            modal.classList.remove('opacity-100');
            modal.classList.add('opacity-0', 'pointer-events-none');
        }

        function selectInitialIntent(intent) {
            userIntent = intent;
            sessionStorage.setItem('vicecity_intent_chosen', intent);
            closeInitialIntentModal();

            const heading = document.getElementById('modalContextHeading');
            if (heading) {
                if (intent === 'BOUGHT') heading.innerHTML = 'What did you pick up? 🛍️';
                else if (intent === 'TRIED_ON') heading.innerHTML = 'What did you try on? 🪞';
                else heading.innerHTML = 'What caught your eye? 👀';
            }

            setTimeout(openApparelModal, 200);
        }

        function returnToInitialIntentModal() {
            closeApparelModal();
            setTimeout(openInitialIntentModal, 200);
        }

        function closeFocusModalAndExplore() {
            closeInitialIntentModal();
            closeApparelModal();
            sessionStorage.setItem('vicecity_intent_chosen', 'EXPLORE');
            showToast('Welcome to Vice City Indira Market!', '📍');
        }

        /* -------------------------------------------------------------------------
         * 6. APPAREL MULTI-SELECT MODAL (STEP 2)
         * ------------------------------------------------------------------------- */
        function openApparelModal() {
            const modal = document.getElementById('entryServiceModal');
            if (!modal) return;
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modal.classList.add('opacity-100');

            modalSelectedList = [...confirmedServicesList];
            renderModalSelectedTray();
            updateApparelChipsVisualState();
            updateModalContinueButton();
            startSearchTypewriter();
        }

        function closeApparelModal() {
            const modal = document.getElementById('entryServiceModal');
            if (!modal) return;
            modal.classList.remove('opacity-100');
            modal.classList.add('opacity-0', 'pointer-events-none');
            stopSearchTypewriter();
        }

        function filterModalCategory(category) {
            renderApparelChipsGrid(category);
            document.querySelectorAll('.category-filter-btn').forEach(btn => {
                btn.classList.remove('bg-street-gold', 'text-black');
                btn.classList.add('bg-obsidian-elevated', 'text-muted-silver');
            });
            event.target.classList.remove('bg-obsidian-elevated', 'text-muted-silver');
            event.target.classList.add('bg-street-gold', 'text-black');
        }

        function renderApparelChipsGrid(categoryFilter) {
            const grid = document.getElementById('modalPlentyChipsGrid');
            if (!grid) return;

            const filtered = categoryFilter === 'ALL' 
                ? APPAREL_CATALOG 
                : APPAREL_CATALOG.filter(item => item.category === categoryFilter);

            grid.innerHTML = filtered.map(item => {
                const isSelected = modalSelectedList.includes(item.name);
                return `
                    <button type="button" onclick="toggleApparelSelection('${item.name}')" 
                        class="apparel-chip-btn w-full p-3 rounded-2xl bg-obsidian-elevated hover:bg-[#202230] border border-obsidian-border text-left flex items-center justify-between transition-all cursor-pointer ${isSelected ? 'is-active-service' : ''}"
                        data-name="${item.name}">
                        <div class="flex items-center gap-2.5">
                            <span class="text-base">${item.icon}</span>
                            <span class="text-xs font-bold text-white">${item.name}</span>
                        </div>
                        <div class="chip-check-badge w-5 h-5 rounded-full border border-white/20 flex items-center justify-center text-[10px] text-white ${isSelected ? 'bg-street-gold border-street-gold text-black font-black' : ''}">
                            ${isSelected ? '✓' : '+'}
                        </div>
                    </button>
                `;
            }).join('');
        }

        function toggleApparelSelection(itemName) {
            const index = modalSelectedList.indexOf(itemName);
            if (index > -1) {
                modalSelectedList.splice(index, 1);
            } else {
                modalSelectedList.push(itemName);
            }
            renderModalSelectedTray();
            updateApparelChipsVisualState();
            updateModalContinueButton();
        }

        function updateApparelChipsVisualState() {
            document.querySelectorAll('.apparel-chip-btn').forEach(btn => {
                const name = btn.getAttribute('data-name');
                const isSelected = modalSelectedList.includes(name);
                const badge = btn.querySelector('.chip-check-badge');

                if (isSelected) {
                    btn.classList.add('is-active-service');
                    if (badge) {
                        badge.classList.add('bg-street-gold', 'border-street-gold', 'text-black', 'font-black');
                        badge.innerHTML = '✓';
                    }
                } else {
                    btn.classList.remove('is-active-service');
                    if (badge) {
                        badge.classList.remove('bg-street-gold', 'border-street-gold', 'text-black', 'font-black');
                        badge.innerHTML = '+';
                    }
                }
            });
        }

        function renderModalSelectedTray() {
            const tray = document.getElementById('modalSelectedTray');
            const container = document.getElementById('modalSelectedPillsContainer');
            if (!tray || !container) return;

            if (modalSelectedList.length === 0) {
                tray.classList.add('hidden');
                container.innerHTML = '';
                return;
            }

            tray.classList.remove('hidden');
            container.innerHTML = modalSelectedList.map(name => `
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-street-gold/20 text-street-gold border border-street-gold/30 whitespace-nowrap">
                    <span>✓ ${name}</span>
                    <button type="button" onclick="event.stopPropagation(); toggleApparelSelection('${name}')" class="hover:text-white cursor-pointer ml-0.5">✕</button>
                </span>
            `).join('');
        }

        function clearAllSelectedServices() {
            modalSelectedList = [];
            renderModalSelectedTray();
            updateApparelChipsVisualState();
            updateModalContinueButton();
        }

        function updateModalContinueButton() {
            const btnText = document.getElementById('btnModalContinueText');
            if (!btnText) return;

            if (modalSelectedList.length === 0) {
                btnText.innerText = 'Continue to Store ➔';
            } else if (modalSelectedList.length === 1) {
                btnText.innerText = `Continue with ${modalSelectedList[0]} ➔`;
            } else {
                btnText.innerText = `Continue with ${modalSelectedList.length} Garments ➔`;
            }
        }

        function addCustomServiceFromSearch() {
            const input = document.getElementById('modalServiceSearchInput');
            if (!input) return;
            const val = input.value.trim();
            if (val && !modalSelectedList.includes(val)) {
                modalSelectedList.push(val);
                input.value = '';
                renderModalSelectedTray();
                updateApparelChipsVisualState();
                updateModalContinueButton();
            }
        }

        function startSearchTypewriter() {
            const input = document.getElementById('modalServiceSearchInput');
            if (!input) return;
            const examples = ["Leather Biker Jacket", "Monogram Puffer", "Corduroy Overshirt", "Branded Tee", "Baggy Cargos", "Pink Sweatshirt"];
            
            searchTypewriterTimer = setInterval(() => {
                if (document.activeElement === input || input.value.length > 0) return;
                searchTypewriterIndex = (searchTypewriterIndex + 1) % examples.length;
                input.placeholder = `Search garment (e.g. ${examples[searchTypewriterIndex]}...)`;
            }, 2400);
        }

        function stopSearchTypewriter() {
            clearInterval(searchTypewriterTimer);
        }

        /* -------------------------------------------------------------------------
         * 7. CURATION TRANSITION LOADER (STEP 3)
         * ------------------------------------------------------------------------- */
        function confirmServicesAndCuratePage() {
            confirmedServicesList = modalSelectedList.length > 0 ? [...modalSelectedList] : ["Export Surplus Brand"];
            closeApparelModal();

            const loader = document.getElementById('viceCuratingLoader');
            const loaderText = document.getElementById('curatingLoaderDynamicText');
            if (loaderText) {
                loaderText.innerText = `Curating highlights for ${confirmedServicesList.slice(0, 2).join(', ')}...`;
            }

            if (loader) {
                loader.classList.remove('opacity-0', 'pointer-events-none');
                loader.classList.add('opacity-100');
            }

            setTimeout(() => {
                if (loader) {
                    loader.classList.remove('opacity-100');
                    loader.classList.add('opacity-0', 'pointer-events-none');
                }
                renderConfirmedServicesBar();
                renderDynamicGroupedHighlights();
                generateAndScrollToReview();
            }, 750);
        }

        /* -------------------------------------------------------------------------
         * 8. ADAPTIVE REVIEW ENGINE & DYNAMIC HIGHLIGHTS (STEP 4)
         * ------------------------------------------------------------------------- */
        function renderConfirmedServicesBar() {
            const container = document.getElementById('confirmedPillsContainer');
            if (!container) return;

            const intentPrefix = userIntent === 'BOUGHT' ? '🛍️ Bought' : (userIntent === 'TRIED_ON' ? '🪞 Tried' : '👀 Browsed');

            container.innerHTML = `
                <span class="px-2 py-0.5 rounded-md text-[10px] font-extrabold bg-white/10 text-white mr-1">${intentPrefix}:</span>
            ` + confirmedServicesList.map(item => `
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-street-gold/20 text-street-gold border border-street-gold/30">
                    ✓ ${item}
                </span>
            `).join('');
        }

        function renderDynamicGroupedHighlights() {
            const container = document.getElementById('dynamicGroupedHighlightsContainer');
            if (!container) return;

            let html = '';

            confirmedServicesList.forEach(serviceName => {
                const libEntry = APPAREL_HIGHLIGHT_LIBRARY[serviceName];
                if (libEntry) {
                    const groupKey = serviceName.replace(/\s+/g, '_').toLowerCase();
                    const currentSelected = selectedHighlightsMap[groupKey] || [];

                    html += `
                        <div class="p-3.5 rounded-2xl bg-obsidian-elevated border border-obsidian-border" data-group-key="${groupKey}">
                            <div class="flex items-center justify-between mb-2.5">
                                <div class="flex items-center gap-1.5">
                                    <span class="text-sm">${libEntry.icon}</span>
                                    <span class="text-xs font-extrabold text-white">${libEntry.title}</span>
                                </div>
                                <span class="text-[10px] text-muted-silver">Tap to add</span>
                            </div>
                            <div class="flex flex-wrap gap-1.5">
                                ${libEntry.highlights.map(hl => {
                                    const isPicked = currentSelected.includes(hl);
                                    return `
                                        <button type="button" onclick="toggleHighlightChip('${groupKey}', '${hl}')" 
                                            class="highlight-chip px-2.5 py-1 rounded-xl text-[11px] font-bold bg-obsidian-card hover:bg-white/10 border border-obsidian-border text-slate-200 transition-all cursor-pointer ${isPicked ? 'is-active-chip' : ''}">
                                            ${isPicked ? '✓ ' : '+ '}${hl}
                                        </button>
                                    `;
                                }).join('')}
                            </div>
                        </div>
                    `;
                }
            });

            // Universal Store & Vibe Group
            const universalKey = 'store_visit';
            const universalSelected = selectedHighlightsMap[universalKey] || [];
            html += `
                <div class="p-3.5 rounded-2xl bg-obsidian-elevated border border-obsidian-border" data-group-key="${universalKey}">
                    <div class="flex items-center justify-between mb-2.5">
                        <div class="flex items-center gap-1.5">
                            <span class="text-sm">🤝</span>
                            <span class="text-xs font-extrabold text-white">Indira Market Store Experience</span>
                        </div>
                        <span class="text-[10px] text-muted-silver">Universal</span>
                    </div>
                    <div class="flex flex-wrap gap-1.5">
                        ${UNIVERSAL_STORE_HIGHLIGHTS.map(hl => {
                            const isPicked = universalSelected.includes(hl);
                            return `
                                <button type="button" onclick="toggleHighlightChip('${universalKey}', '${hl}')" 
                                    class="highlight-chip px-2.5 py-1 rounded-xl text-[11px] font-bold bg-obsidian-card hover:bg-white/10 border border-obsidian-border text-slate-200 transition-all cursor-pointer ${isPicked ? 'is-active-chip' : ''}">
                                    ${isPicked ? '✓ ' : '+ '}${hl}
                                </button>
                            `;
                        }).join('')}
                    </div>
                </div>
            `;

            container.innerHTML = html;
        }

        function toggleHighlightChip(groupKey, highlightText) {
            if (!selectedHighlightsMap[groupKey]) {
                selectedHighlightsMap[groupKey] = [];
            }
            const list = selectedHighlightsMap[groupKey];
            const idx = list.indexOf(highlightText);
            if (idx > -1) {
                list.splice(idx, 1);
            } else {
                list.push(highlightText);
            }
            renderDynamicGroupedHighlights();
        }

        function initCustomerNotesCounter() {
            const textarea = document.getElementById('reviewCustomerNotes');
            const counter = document.getElementById('reviewCustomerNotesCount');
            if (!textarea || !counter) return;

            textarea.addEventListener('input', () => {
                customerWrittenReviewNotes = textarea.value;
                const words = textarea.value.trim().split(/\s+/).filter(Boolean).length;
                counter.innerText = `${words} words`;
            });
        }

        function setReviewLength(len) {
            currentReviewLength = len;
            ['SHORT', 'BALANCED', 'DETAILED'].forEach(l => {
                const btn = document.getElementById(`lenBtn-${l}`);
                if (btn) {
                    if (l === len) {
                        btn.className = 'px-2.5 py-1 rounded-lg bg-street-gold text-black font-extrabold transition-all cursor-pointer';
                    } else {
                        btn.className = 'px-2.5 py-1 rounded-lg text-muted-silver hover:text-white transition-all cursor-pointer';
                    }
                }
            });
            regenerateReviewDraft();
        }

        function setReviewLanguage(lang) {
            currentReviewLang = lang;
            ['ENGLISH', 'HINGLISH'].forEach(l => {
                const btn = document.getElementById(`langBtn-${l}`);
                if (btn) {
                    if (l === lang) {
                        btn.className = 'px-2.5 py-1 rounded-lg bg-street-gold text-black font-extrabold transition-all cursor-pointer';
                    } else {
                        btn.className = 'px-2.5 py-1 rounded-lg text-muted-silver hover:text-white transition-all cursor-pointer';
                    }
                }
            });
            regenerateReviewDraft();
        }

        /* -------------------------------------------------------------------------
         * 9. AI REVIEW SYNTHESIS ENGINE (Authentic, Preserves Voice, No Hallucinations)
         * ------------------------------------------------------------------------- */
        const REVIEW_AI_ENGINE = {
            generate(lang = 'ENGLISH', length = 'SHORT') {
                const items = confirmedServicesList.length > 0 ? confirmedServicesList : ["Export Surplus Brand"];
                const itemsText = items.join(' and ');
                const userNotes = customerWrittenReviewNotes.trim();

                const allHighlights = [];
                Object.values(selectedHighlightsMap).forEach(list => {
                    if (Array.isArray(list)) allHighlights.push(...list);
                });

                if (lang === 'HINGLISH') {
                    return this.synthesizeHinglish({ items, itemsText, userNotes, allHighlights, length });
                }
                return this.synthesizeEnglish({ items, itemsText, userNotes, allHighlights, length });
            },

            synthesizeEnglish({ items, itemsText, userNotes, allHighlights, length }) {
                if (userNotes.length > 0) {
                    const clean = /[.!?]$/.test(userNotes) ? userNotes : userNotes + '.';
                    if (length === 'SHORT') {
                        return `${clean} Visited ${STORE_CONFIG.name} in Indira Market for ${itemsText}. Recommended shop!`;
                    } else {
                        const hlSnippet = allHighlights.length > 0 ? ` Appreciated the ${allHighlights[0].toLowerCase()}.` : '';
                        return `${clean} Visited ${STORE_CONFIG.name} at Shop 30, Indira Market for ${itemsText}.${hlSnippet} Good experience.`;
                    }
                }

                const topHl = allHighlights.length > 0 ? allHighlights[0] : null;
                const secondHl = allHighlights.length > 1 ? allHighlights[1] : null;

                if (length === 'SHORT') {
                    if (topHl) {
                        const shortOptions = [
                            `Great experience at ${STORE_CONFIG.name} in Indira Market picking up ${itemsText}. Loved the ${topHl.toLowerCase()}!`,
                            `Checked out ${STORE_CONFIG.name} for ${itemsText}. The ${topHl.toLowerCase()} stood out. Definitely worth visiting in Dehradun!`,
                            `Solid export surplus collection at ${STORE_CONFIG.name}. Got ${itemsText} — ${topHl.toLowerCase()} was on point.`
                        ];
                        return shortOptions[Math.floor(Math.random() * shortOptions.length)];
                    }
                    return `Had a great visit at ${STORE_CONFIG.name} in Indira Market for ${itemsText}. Clean shop and helpful staff!`;
                }

                if (length === 'BALANCED') {
                    let highlightSentence = '';
                    if (topHl && secondHl) {
                        highlightSentence = ` The ${topHl.toLowerCase()} and ${secondHl.toLowerCase()} were impressive.`;
                    } else if (topHl) {
                        highlightSentence = ` Especially liked the ${topHl.toLowerCase()}.`;
                    }
                    return `Visited ${STORE_CONFIG.name} at Indira Market, Rajpur Road for ${itemsText}.${highlightSentence} Genuine international brand garments at fair prices, and the staff is very polite. Will visit again!`;
                }

                // DETAILED
                const hlListText = allHighlights.length > 0 
                    ? ` Particularly noticed the ${allHighlights.slice(0, 3).map(h => h.toLowerCase()).join(', ')}.`
                    : '';
                return `Really glad I stopped by ${STORE_CONFIG.name} (Shop 30, Indira Market) for ${itemsText}. Their export surplus collection for boys and girls has genuine international brand quality that's hard to find in Dehradun.${hlListText} Great dealing, fair rates, and spotless garments. Highly recommend checking them out!`;
            },

            synthesizeHinglish({ items, itemsText, userNotes, allHighlights, length }) {
                if (userNotes.length > 0) {
                    const clean = /[.!?]$/.test(userNotes) ? userNotes : userNotes + '.';
                    return `${clean} ${STORE_CONFIG.name} Indira Market se ${itemsText} liya, bohot accha experience raha!`;
                }

                const topHl = allHighlights.length > 0 ? allHighlights[0] : null;

                if (length === 'SHORT') {
                    if (topHl) {
                        return `${STORE_CONFIG.name} Indira Market se ${itemsText} liya, ${topHl.toLowerCase()} ek number hai! Must visit shop.`;
                    }
                    return `${STORE_CONFIG.name} ka collection bohot sahi hai, ${itemsText} ki quality aur fit perfect aayi!`;
                }

                if (length === 'BALANCED') {
                    const hlNote = topHl ? ` Khaaskar inka ${topHl.toLowerCase()} bohot pasand aaya.` : '';
                    return `Indira Market me ${STORE_CONFIG.name} visit kiya for ${itemsText}.${hlNote} International brand surplus kapde kaafi reasonable rates me mil gaye. Staff ka behaviour bhi bohot polite tha.`;
                }

                return `Dehradun me genuine export surplus garments ke liye ${STORE_CONFIG.name} (Shop 30, Indira Market) best spot hai. ${itemsText} purchase kiya aur fabric se lekar fitting sab top-notch hai. Boys aur girls dono ke liye fresh collection rehta hai. Highly recommended!`;
            }
        };

        function generateAndScrollToReview() {
            regenerateReviewDraft();
            const outputCard = document.getElementById('reviewOutputCard');
            if (outputCard) {
                outputCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                outputCard.classList.add('ring-2', 'ring-street-gold');
                setTimeout(() => {
                    outputCard.classList.remove('ring-2', 'ring-street-gold');
                }, 1500);
            }
        }

        function regenerateReviewDraft() {
            const draft = REVIEW_AI_ENGINE.generate(currentReviewLang, currentReviewLength);
            typeReviewText(draft);
        }

        function typeReviewText(text) {
            const display = document.getElementById('aiReviewDisplay');
            const cursor = document.getElementById('aiCursor');
            if (!display) return;

            clearTimeout(typewriterTimeout);
            display.innerText = '';
            if (cursor) cursor.style.display = 'inline-block';

            let i = 0;
            const speed = 16;

            function typeNext() {
                if (i < text.length) {
                    display.innerText += text.charAt(i);
                    i++;
                    typewriterTimeout = setTimeout(typeNext, speed);
                } else {
                    if (cursor) cursor.style.display = 'none';
                }
            }
            typeNext();
        }

        /* -------------------------------------------------------------------------
         * 10. GOOGLE REVIEW REDIRECTION & CLIPBOARD (Popup-Blocker Proof)
         * ------------------------------------------------------------------------- */
        function copyAndRedirectReview() {
            const display = document.getElementById('aiReviewDisplay');
            const reviewText = display ? display.innerText.trim() : '';
            const targetUrl = STORE_CONFIG.reviews.writeReviewUrl;

            let reviewTab = null;
            try {
                reviewTab = window.open(targetUrl, '_blank', 'noopener,noreferrer');
            } catch (err) {
                console.warn('Direct popup open intercepted:', err);
            }

            copyTextToClipboard(reviewText, () => {
                showToast('Review copied! Opening Google Review page...', '📋');
                
                if (!reviewTab || reviewTab.closed || typeof reviewTab.closed === 'undefined') {
                    setTimeout(() => {
                        window.location.href = targetUrl;
                    }, 400);
                }
            });
        }

        function skipDirectToGoogleReview() {
            const targetUrl = STORE_CONFIG.reviews.writeReviewUrl;
            let tab = null;
            try {
                tab = window.open(targetUrl, '_blank', 'noopener,noreferrer');
            } catch (e) {}

            showToast('Opening Google Review directly...', '⭐');
            if (!tab || tab.closed || typeof tab.closed === 'undefined') {
                window.location.href = targetUrl;
            }
        }

        function copyTextToClipboard(text, onSuccess) {
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(text)
                    .then(() => { if (onSuccess) onSuccess(); })
                    .catch(() => { fallbackExecCommandCopy(text, onSuccess); });
            } else {
                fallbackExecCommandCopy(text, onSuccess);
            }
        }

        function fallbackExecCommandCopy(text, onSuccess) {
            const textarea = document.createElement('textarea');
            textarea.value = text;
            textarea.style.position = 'fixed';
            textarea.style.left = '-9999px';
            textarea.style.top = '-9999px';
            document.body.appendChild(textarea);
            textarea.focus();
            textarea.select();

            try {
                document.execCommand('copy');
                if (onSuccess) onSuccess();
            } catch (err) {
                console.error('Fallback execCommand copy failed:', err);
            } finally {
                document.body.removeChild(textarea);
            }
        }

        /* -------------------------------------------------------------------------
         * 11. WHATSAPP INQUIRY HANDOFF (Direct to Verified Shop Number: 97604 41031)
         * ------------------------------------------------------------------------- */
        function sendWhatsAppInquiry(topic) {
            const phone = STORE_CONFIG.contact.whatsapp;
            const message = encodeURIComponent(`Hi ${STORE_CONFIG.name} (Shop 30, Indira Market), I'm inquiring about: ${topic}. Could you share current available sizes & rates?`);
            const url = `https://wa.me/${phone}?text=${message}`;
            window.open(url, '_blank', 'noopener,noreferrer');
        }

        /* -------------------------------------------------------------------------
         * 12. TESTIMONIALS & FAQS
         * ------------------------------------------------------------------------- */
        const TESTIMONIALS = [
            { name: "Rahul Negi", text: "Best export surplus shop in Indira Market! Got a genuine branded winter jacket at almost 1/3rd of showroom price.", stars: 5 },
            { name: "Pooja Rawat", text: "Loved their girls wear collection. Sweatshirts and flared denims are very trendy. Staff is super polite!", stars: 5 },
            { name: "Vikas Chauhan", text: "Heavy quality leather jackets and fleeces. Sizing was spot on and they have a comfortable trial area.", stars: 5 },
            { name: "Ankit Sharma", text: "Rajpur Road ki best shop for international brand tees and cargos. 10/10 shopping experience.", stars: 5 }
        ];

        function renderTestimonialsMarquee() {
            const marquee = document.getElementById('testimonialsMarquee');
            if (!marquee) return;

            const cards = TESTIMONIALS.map(t => `
                <div class="w-64 p-3.5 rounded-2xl bg-obsidian-card border border-obsidian-border flex flex-col justify-between flex-shrink-0">
                    <p class="text-xs text-slate-300 leading-relaxed font-medium mb-2">"${t.text}"</p>
                    <div class="flex items-center justify-between pt-2 border-t border-obsidian-border/60">
                        <span class="text-[11px] font-bold text-white">${t.name}</span>
                        <span class="text-[10px] text-street-gold">★★★★★</span>
                    </div>
                </div>
            `).join('');

            marquee.innerHTML = cards + cards;
        }

        const FAQS = [
            {
                q: "Where exactly is Vice City located in Dehradun?",
                a: "We are located at Shop no. 30, Rajpur Road, Indira Market, Dehradun (near the main entrance corridor)."
            },
            {
                q: "Are the garments export surplus / international brands?",
                a: "Yes! We specialize in authentic export surplus readymade garments from top international brands for both boys and girls at unbeatable value."
            },
            {
                q: "Do you have sizes for both boys and girls?",
                a: "Absolutely. We stock a full range from XS to XXL across winter jackets, hoodies, tees, track pants, cargos, and denims for both boys and girls."
            },
            {
                q: "Can I try clothes on before buying?",
                a: "Yes, we have trial facilities inside the shop so you can verify fitting, styling, and comfort before purchase."
            }
        ];

        function renderFAQs() {
            const container = document.getElementById('faqContainer');
            if (!container) return;

            container.innerHTML = FAQS.map((faq, index) => `
                <div class="rounded-2xl bg-obsidian-card border border-obsidian-border overflow-hidden">
                    <button type="button" onclick="toggleFaq(${index})" 
                        class="w-full p-3.5 text-left flex items-center justify-between text-xs font-bold text-white hover:text-street-gold transition-colors cursor-pointer">
                        <span>${faq.q}</span>
                        <span id="faqIcon-${index}" class="text-xs text-muted-silver transition-transform">▼</span>
                    </button>
                    <div id="faqAnswer-${index}" class="px-3.5 pb-3.5 text-[11px] text-muted-silver leading-relaxed hidden">
                        ${faq.a}
                    </div>
                </div>
            `).join('');
        }

        function toggleFaq(index) {
            const ans = document.getElementById(`faqAnswer-${index}`);
            const icon = document.getElementById(`faqIcon-${index}`);
            if (!ans) return;

            const isClosed = ans.classList.contains('hidden');
            if (isClosed) {
                ans.classList.remove('hidden');
                if (icon) icon.style.transform = 'rotate(180deg)';
            } else {
                ans.classList.add('hidden');
                if (icon) icon.style.transform = 'rotate(0deg)';
            }
        }

        /* -------------------------------------------------------------------------
         * 13. TOAST & LIGHTBOX UTILITIES
         * ------------------------------------------------------------------------- */
        function showToast(msg, icon = '📋') {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMessage');
            const toastIcon = document.getElementById('toastIcon');
            if (!toast) return;

            if (toastMsg) toastMsg.innerText = msg;
            if (toastIcon) toastIcon.innerText = icon;

            toast.classList.remove('-translate-y-24', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('-translate-y-24', 'opacity-0');
            }, 3000);
        }

        function openLightbox(src, caption) {
            const lb = document.getElementById('imageLightbox');
            const img = document.getElementById('lightboxImage');
            const cap = document.getElementById('lightboxCaption');
            if (!lb || !img) return;

            img.src = src;
            if (cap) cap.innerText = caption || 'Vice City Indira Market';
            lb.classList.remove('opacity-0', 'pointer-events-none');
            lb.classList.add('opacity-100');
        }

        function closeLightbox() {
            const lb = document.getElementById('imageLightbox');
            if (lb) {
                lb.classList.remove('opacity-100');
                lb.classList.add('opacity-0', 'pointer-events-none');
            }
        }
    </script>
</body>
</html>