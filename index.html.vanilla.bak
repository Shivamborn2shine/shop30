<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>VICE CITY — Export Surplus Brand, Boys & Girls Wear | Dehradun</title>
    <meta name="description" content="VICE CITY: Export Surplus, International Brands Readymade Garments for boys & girls. Shop no. 30, Rajpur Road, Indira Market, Dehradun. 1-Tap Google Review & WhatsApp Assistant.">

    <!-- Google Fonts: Plus Jakarta Sans & Cinzel (Matching Vice City's 3D Gold Store Sign) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CSS via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        obsidian: '#090A0E',
                        'obsidian-card': '#12131A',
                        'obsidian-elevated': '#191B24',
                        'obsidian-border': '#252736',
                        'obsidian-border-light': '#36394C',
                        'neon-violet': '#A855F7',
                        'neon-violet-glow': 'rgba(168, 85, 247, 0.25)',
                        'street-gold': '#D4AF37', // Metallic gold matching Vice City 3D sign
                        'street-gold-light': '#F7E7A9',
                        'street-gold-pale': 'rgba(212, 175, 55, 0.12)',
                        'chrome-silver': '#E2E8F0',
                        'muted-silver': '#94A3B8',
                        'whatsapp-green': '#25D366'
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        serif: ['Cinzel', 'serif']
                    },
                    boxShadow: {
                        'gold-glow': '0 0 25px -4px rgba(212, 175, 55, 0.35)',
                        'neon': '0 0 25px -5px rgba(168, 85, 247, 0.35)',
                        'card': '0 10px 30px -10px rgba(0, 0, 0, 0.7)'
                    }
                }
            }
        };
    </script>

    <style>
        * {
            -webkit-tap-highlight-color: transparent;
            box-sizing: border-box;
        }

        body {
            background-color: #060709;
            color: #F8F8FC;
            font-family: 'Plus Jakarta Sans', sans-serif;
            overflow-x: hidden;
        }

        /* Leather Grain Simulation */
        .leather-texture {
            background-color: #101015;
            background-image: 
                radial-gradient(circle at 50% 50%, rgba(25, 25, 35, 0.6) 0%, rgba(10, 10, 14, 0.95) 100%),
                repeating-linear-gradient(45deg, rgba(255,255,255,0.015) 0px, rgba(255,255,255,0.015) 1px, transparent 1px, transparent 4px);
        }

        .leather-stitch-left {
            border-right: 2px dashed rgba(255, 255, 255, 0.2);
        }

        .leather-stitch-right {
            border-left: 2px dashed rgba(255, 255, 255, 0.2);
        }

        /* Jacket 3D Flap Animations */
        .jacket-flap-left {
            transform-origin: left center;
            transition: transform 0.85s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s ease;
            will-change: transform, opacity;
        }

        .jacket-flap-right {
            transform-origin: right center;
            transition: transform 0.85s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s ease;
            will-change: transform, opacity;
        }

        .jacket-unzipped-left {
            transform: perspective(1200px) rotateY(-80deg) translateX(-100%);
            opacity: 0.15;
        }

        .jacket-unzipped-right {
            transform: perspective(1200px) rotateY(80deg) translateX(100%);
            opacity: 0.15;
        }

        /* Zipper Pull Descent */
        .zipper-pull-down {
            transition: transform 0.75s cubic-bezier(0.25, 1, 0.5, 1);
            transform: translateY(92vh);
        }

        /* Marquee Animation */
        @keyframes marquee {
            0% { transform: translateX(0%); }
            100% { transform: translateX(-50%); }
        }

        .animate-marquee {
            display: flex;
            width: 200%;
            animation: marquee 24s linear infinite;
        }

        .animate-marquee:hover {
            animation-play-state: paused;
        }

        /* Breathing Skeleton Pulse */
        @keyframes breathPulse {
            0%, 100% { opacity: 0.45; transform: scale(0.995); }
            50% { opacity: 0.85; transform: scale(1.005); }
        }

        .skeleton-breathing {
            animation: breathPulse 1.8s ease-in-out infinite;
        }

        /* Pulsing Cursor */
        @keyframes cursorBlink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0; }
        }

        .cursor-blink {
            animation: cursorBlink 0.8s infinite;
        }

        /* Rotating Medallion */
        @keyframes spinSlow {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .animate-spin-slow {
            animation: spinSlow 8s linear infinite;
        }

        /* Chip active states */
        .is-active-chip {
            background-color: #1A1A28 !important;
            border-color: #D4AF37 !important;
            color: #FFFFFF !important;
            box-shadow: 0 0 12px -2px rgba(212, 175, 55, 0.35);
        }

        .is-active-service {
            background: linear-gradient(135deg, rgba(212, 175, 55, 0.16), rgba(168, 85, 247, 0.12)) !important;
            border-color: #D4AF37 !important;
            color: #FFFFFF !important;
            box-shadow: 0 0 16px -4px rgba(212, 175, 55, 0.4);
        }

        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>

<body class="min-h-screen flex flex-col items-center justify-start antialiased selection:bg-street-gold selection:text-black">

    <!-- ========================================================================= -->
    <!-- 1. LEATHER JACKET ZIPPER OPENING ANIMATION OVERLAY                        -->
    <!-- ========================================================================= -->
    <div id="jacketIntroOverlay" class="fixed inset-0 z-[99999] bg-[#060709] flex items-center justify-center overflow-hidden transition-opacity duration-700 select-none">
        <!-- Top Bar: Skip Intro Button -->
        <div class="absolute top-5 right-5 z-50">
            <button id="btnSkipJacketIntro" onclick="skipJacketIntro()" 
                class="px-4 py-1.5 rounded-full bg-white/10 hover:bg-white/20 active:scale-95 text-white/90 hover:text-white text-xs font-semibold backdrop-blur-md border border-white/20 transition-all shadow-lg flex items-center gap-1.5 cursor-pointer">
                <span>Skip Intro</span>
                <span class="text-xs opacity-60">✕</span>
            </button>
        </div>

        <!-- Jacket Container (Mobile Frame Dimensions) -->
        <div id="jacketStage" class="relative w-full max-w-[480px] h-full flex items-center justify-center overflow-hidden" onclick="triggerJacketUnzip()">
            
            <!-- Underneath Glow / 3D Gold Vice City Teaser -->
            <div id="jacketUnderglow" class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none opacity-0 transition-opacity duration-500">
                <div class="w-72 h-72 rounded-full bg-gradient-to-tr from-street-gold/30 via-amber-600/20 to-purple-600/20 blur-3xl"></div>
                <div class="absolute text-center px-4">
                    <span class="px-3 py-1 rounded-full text-[10px] font-extrabold tracking-widest bg-street-gold/20 border border-street-gold/40 text-street-gold uppercase mb-2 inline-block">
                        Entering Store
                    </span>
                    <h2 class="text-3xl sm:text-4xl font-extrabold tracking-wider text-street-gold font-serif uppercase drop-shadow-lg">
                        VICE CITY
                    </h2>
                    <p class="text-[11px] font-bold text-slate-300 tracking-wider mt-1 uppercase">
                        Export Surplus • Indira Market
                    </p>
                </div>
            </div>

            <!-- Left Leather Jacket Panel -->
            <div id="jacketLeftFlap" class="jacket-flap-left absolute top-0 bottom-0 left-0 w-1/2 leather-texture leather-stitch-left z-20 flex flex-col justify-between overflow-hidden shadow-2xl">
                <!-- Biker Collar & Snap Studs -->
                <div class="p-4 pt-10 flex flex-col items-end">
                    <div class="w-14 h-16 border-b-2 border-l-2 border-white/20 rounded-bl-3xl bg-black/40 rotate-12 flex items-center justify-center shadow-inner">
                        <div class="w-3.5 h-3.5 rounded-full bg-gradient-to-tr from-street-gold to-amber-200 border border-black shadow"></div>
                    </div>
                    <!-- Pocket Zipper Mock -->
                    <div class="w-20 h-1 bg-white/30 rounded mt-8 mr-2 rotate-[-15deg] shadow"></div>
                </div>

                <!-- Mid Seam Folds -->
                <div class="px-4 opacity-30 space-y-6">
                    <div class="h-24 border-r border-dashed border-white/10"></div>
                </div>

                <!-- Bottom Waist Hem -->
                <div class="p-4 pb-8 flex items-center justify-between border-t border-white/10 bg-black/30">
                    <div class="w-8 h-2 bg-white/20 rounded"></div>
                    <div class="text-[10px] tracking-widest font-black text-street-gold/50 font-serif">VICE</div>
                </div>
            </div>

            <!-- Right Leather Jacket Panel -->
            <div id="jacketRightFlap" class="jacket-flap-right absolute top-0 bottom-0 right-0 w-1/2 leather-texture leather-stitch-right z-20 flex flex-col justify-between overflow-hidden shadow-2xl">
                <!-- Biker Collar & Snap Studs -->
                <div class="p-4 pt-10 flex flex-col items-start">
                    <div class="w-14 h-16 border-b-2 border-r-2 border-white/20 rounded-br-3xl bg-black/40 -rotate-12 flex items-center justify-center shadow-inner">
                        <div class="w-3.5 h-3.5 rounded-full bg-gradient-to-tr from-street-gold to-amber-200 border border-black shadow"></div>
                    </div>
                    <!-- Chest Seam Mock -->
                    <div class="w-16 h-1 bg-white/25 rounded mt-8 ml-2 rotate-[15deg] shadow"></div>
                </div>

                <!-- Mid Seam Folds -->
                <div class="px-4 opacity-30 space-y-6">
                    <div class="h-24 border-l border-dashed border-white/10"></div>
                </div>

                <!-- Bottom Waist Hem -->
                <div class="p-4 pb-8 flex items-center justify-between border-t border-white/10 bg-black/30">
                    <div class="text-[10px] tracking-widest font-black text-street-gold/50 font-serif">CITY</div>
                    <div class="w-8 h-2 bg-white/20 rounded"></div>
                </div>
            </div>

            <!-- Center Zipper Teeth Track -->
            <div id="zipperTrack" class="absolute top-0 bottom-0 left-1/2 -translate-x-1/2 w-4 z-30 flex flex-col items-center pointer-events-none opacity-80">
                <svg class="w-full h-full" preserveAspectRatio="none" viewBox="0 0 16 1000">
                    <defs>
                        <pattern id="zipperPattern" width="16" height="12" patternUnits="userSpaceOnUse">
                            <rect x="2" y="1" width="5" height="4" rx="1" fill="#D4AF37" stroke="#856404" stroke-width="0.8"/>
                            <rect x="9" y="7" width="5" height="4" rx="1" fill="#FFF" stroke="#856404" stroke-width="0.8"/>
                            <line x1="8" y1="0" x2="8" y2="12" stroke="#101014" stroke-width="1.5"/>
                        </pattern>
                    </defs>
                    <rect width="16" height="1000" fill="url(#zipperPattern)"/>
                </svg>
            </div>

            <!-- Heavy Metallic Zipper Pull Tab -->
            <div id="zipperSliderPull" class="absolute top-12 left-1/2 -translate-x-1/2 z-40 cursor-pointer flex flex-col items-center">
                <div class="w-6 h-6 rounded-t-md bg-gradient-to-b from-street-gold-light via-street-gold to-amber-700 border border-amber-300 shadow-xl flex items-center justify-center">
                    <div class="w-2.5 h-1 bg-black rounded-sm"></div>
                </div>
                <div class="w-5 h-12 -mt-1 rounded-b-lg bg-gradient-to-b from-amber-200 via-street-gold to-amber-800 border border-amber-300 shadow-2xl flex flex-col items-center justify-between py-1.5 active:scale-95 transition-transform">
                    <div class="w-2 h-2 rounded-full bg-slate-900/60 shadow-inner"></div>
                    <span class="text-[7px] font-black text-black tracking-tighter uppercase font-serif rotate-90 my-auto">VC</span>
                    <div class="w-3 h-0.5 bg-amber-900 rounded"></div>
                </div>
            </div>

            <!-- Tap Instruction Pill -->
            <div id="jacketTapHint" class="absolute bottom-12 z-50 px-5 py-2.5 rounded-full bg-black/85 border border-street-gold/30 backdrop-blur-md text-white/90 text-xs font-semibold tracking-wide flex items-center gap-2 pointer-events-none animate-pulse shadow-2xl">
                <svg class="w-4 h-4 text-street-gold animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                </svg>
                <span>Pull down zipper or tap to enter</span>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- TOAST NOTIFICATION                                                        -->
    <!-- ========================================================================= -->
    <div id="toast" class="fixed top-5 z-[9999] max-w-sm px-5 py-3 rounded-2xl bg-obsidian-elevated/95 backdrop-blur-md text-white border border-street-gold/50 shadow-gold-glow text-xs font-bold flex items-center gap-2.5 transform -translate-y-24 opacity-0 transition-all duration-300 pointer-events-none">
        <span id="toastIcon" class="text-base">📋</span>
        <span id="toastMessage">Review copied! Opening Google...</span>
    </div>

    <!-- ========================================================================= -->
    <!-- LIGHTBOX MODAL                                                            -->
    <!-- ========================================================================= -->
    <div id="imageLightbox" class="fixed inset-0 z-[9998] bg-black/95 backdrop-blur-xl flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-300" onclick="closeLightbox()">
        <button class="absolute top-5 right-5 text-white/80 hover:text-white text-2xl p-2 z-10 cursor-pointer">✕</button>
        <div class="max-w-md w-full relative" onclick="event.stopPropagation()">
            <img id="lightboxImage" src="" alt="Vice City Drop" class="w-full h-auto max-h-[80vh] object-contain rounded-2xl shadow-2xl border border-street-gold/20">
            <p id="lightboxCaption" class="text-center text-xs text-slate-300 mt-3 font-medium"></p>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- STEP 1: INITIAL INTENT FOCUS MODAL                                       -->
    <!-- ========================================================================= -->
    <div id="entryFocusModal" class="fixed inset-0 z-[9000] bg-black/85 backdrop-blur-md flex items-center justify-center p-4 transition-all duration-300 opacity-0 pointer-events-none">
        <div class="w-full max-w-sm rounded-3xl bg-obsidian-card border border-obsidian-border p-6 shadow-2xl text-center relative overflow-hidden">
            <div class="absolute -top-12 left-1/2 -translate-x-1/2 w-48 h-24 bg-street-gold/20 blur-2xl rounded-full pointer-events-none"></div>

            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-extrabold uppercase tracking-widest bg-street-gold/15 border border-street-gold/30 text-street-gold mb-3">
                <span>📍</span> Indira Market • Dehradun
            </span>

            <h2 class="text-2xl font-black text-white tracking-tight font-serif mb-1">How Was Your Visit?</h2>
            <p class="text-xs text-muted-silver mb-5">Tap what describes your time at Vice City today:</p>

            <div class="space-y-3">
                <!-- 1. I Bought Clothes -->
                <button type="button" onclick="selectInitialIntent('BOUGHT')" 
                    class="w-full p-4 rounded-2xl bg-obsidian-elevated hover:bg-[#202230] active:scale-[0.98] border border-obsidian-border hover:border-street-gold/60 transition-all flex items-center gap-3.5 text-left group shadow-sm cursor-pointer">
                    <div class="w-11 h-11 rounded-xl bg-street-gold/15 border border-street-gold/30 flex items-center justify-center text-xl flex-shrink-0 group-hover:scale-105 transition-transform">
                        🛍️
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="text-sm font-extrabold text-white flex items-center justify-between">
                            <span>I Bought Clothes</span>
                            <span class="text-street-gold text-xs opacity-0 group-hover:opacity-100 transition-opacity">➔</span>
                        </div>
                        <p class="text-[11px] text-muted-silver mt-0.5">Took home fresh export surplus garments</p>
                    </div>
                </button>

                <!-- 2. Tried On Clothes -->
                <button type="button" onclick="selectInitialIntent('TRIED_ON')" 
                    class="w-full p-4 rounded-2xl bg-obsidian-elevated hover:bg-[#202230] active:scale-[0.98] border border-obsidian-border hover:border-neon-violet/60 transition-all flex items-center gap-3.5 text-left group shadow-sm cursor-pointer">
                    <div class="w-11 h-11 rounded-xl bg-neon-violet/15 border border-neon-violet/30 flex items-center justify-center text-xl flex-shrink-0 group-hover:scale-105 transition-transform">
                        🪞
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="text-sm font-extrabold text-white flex items-center justify-between">
                            <span>Tried On Garments</span>
                            <span class="text-neon-violet text-xs opacity-0 group-hover:opacity-100 transition-opacity">➔</span>
                        </div>
                        <p class="text-[11px] text-muted-silver mt-0.5">Tested fits, sizes & mirror styles</p>
                    </div>
                </button>

                <!-- 3. Just Browsed / Exploring -->
                <button type="button" onclick="selectInitialIntent('BROWSED')" 
                    class="w-full p-4 rounded-2xl bg-obsidian-elevated hover:bg-[#202230] active:scale-[0.98] border border-obsidian-border hover:border-white/40 transition-all flex items-center gap-3.5 text-left group shadow-sm cursor-pointer">
                    <div class="w-11 h-11 rounded-xl bg-white/10 border border-white/20 flex items-center justify-center text-xl flex-shrink-0 group-hover:scale-105 transition-transform">
                        👀
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="text-sm font-extrabold text-white flex items-center justify-between">
                            <span>Just Browsing & Checking Drops</span>
                            <span class="text-white text-xs opacity-0 group-hover:opacity-100 transition-opacity">➔</span>
                        </div>
                        <p class="text-[11px] text-muted-silver mt-0.5">Checked international brands & store vibe</p>
                    </div>
                </button>
            </div>

            <!-- Direct Skip Option -->
            <div class="mt-5 pt-4 border-t border-obsidian-border flex flex-col items-center gap-2">
                <button type="button" onclick="skipDirectToGoogleReview()" 
                    class="text-xs font-bold text-street-gold hover:text-white transition-colors flex items-center gap-1 cursor-pointer">
                    <span>Already know what to write? Skip to Google</span>
                    <span>⭐ ➔</span>
                </button>
                <button type="button" onclick="closeFocusModalAndExplore()" 
                    class="text-[11px] text-muted-silver hover:text-white transition-colors cursor-pointer mt-1">
                    Just browse store page without review
                </button>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- STEP 2: APPAREL MULTI-SELECT MODAL                                       -->
    <!-- ========================================================================= -->
    <div id="entryServiceModal" class="fixed inset-0 z-[9000] bg-black/85 backdrop-blur-md flex items-end sm:items-center justify-center p-0 sm:p-4 transition-all duration-300 opacity-0 pointer-events-none">
        <div class="w-full max-w-md max-h-[90vh] rounded-t-3xl sm:rounded-3xl bg-obsidian-card border border-obsidian-border flex flex-col shadow-2xl overflow-hidden animate-in slide-in-from-bottom-6 duration-300">
            <!-- Modal Header -->
            <div class="p-5 pb-3 border-b border-obsidian-border flex items-center justify-between bg-obsidian-elevated/50 flex-shrink-0">
                <div class="flex items-center gap-2">
                    <button type="button" onclick="returnToInitialIntentModal()" 
                        class="w-8 h-8 rounded-full bg-obsidian-card hover:bg-white/10 border border-obsidian-border flex items-center justify-center text-xs text-white transition-all cursor-pointer">
                        ←
                    </button>
                    <div>
                        <h3 id="modalContextHeading" class="text-base font-extrabold text-white">What did you pick up? 🛍️</h3>
                        <p class="text-[11px] text-muted-silver">Tap all that apply — multi-select enabled</p>
                    </div>
                </div>
                <button type="button" onclick="closeApparelModal()" class="w-8 h-8 rounded-full bg-obsidian-card hover:bg-white/10 border border-obsidian-border flex items-center justify-center text-xs text-muted-silver hover:text-white transition-all cursor-pointer">
                    ✕
                </button>
            </div>

            <!-- Modal Search with Typewriter Placeholder -->
            <div class="p-4 pb-2 flex-shrink-0">
                <div class="relative flex items-center">
                    <span class="absolute left-3.5 text-muted-silver text-xs">🔍</span>
                    <input type="text" id="modalServiceSearchInput" 
                        placeholder="Search garment (e.g. Leather Jacket...)" 
                        class="w-full pl-9 pr-10 py-2.5 rounded-xl bg-obsidian-elevated border border-obsidian-border text-white text-xs placeholder:text-muted-silver focus:outline-none focus:border-street-gold transition-all">
                    <button type="button" onclick="addCustomServiceFromSearch()" 
                        class="absolute right-2.5 w-6 h-6 rounded-lg bg-street-gold hover:bg-amber-500 text-black text-xs font-black flex items-center justify-center transition-all cursor-pointer shadow">
                        ➔
                    </button>
                </div>
            </div>

            <!-- Active Selected Items Tray -->
            <div id="modalSelectedTray" class="px-4 py-1.5 flex items-center gap-1.5 overflow-x-auto no-scrollbar flex-shrink-0 border-b border-obsidian-border/50 hidden">
                <span class="text-[10px] font-bold text-muted-silver uppercase whitespace-nowrap">Selected:</span>
                <div id="modalSelectedPillsContainer" class="flex items-center gap-1.5"></div>
                <button type="button" onclick="clearAllSelectedServices()" class="text-[10px] text-red-400 hover:text-red-300 font-bold underline ml-1 whitespace-nowrap cursor-pointer">
                    Clear
                </button>
            </div>

            <!-- Category Filter Tabs -->
            <div class="px-4 py-2 flex items-center gap-1.5 overflow-x-auto no-scrollbar flex-shrink-0">
                <button type="button" onclick="filterModalCategory('ALL')" class="category-filter-btn active-cat px-3 py-1 rounded-full text-xs font-bold bg-street-gold text-black border border-street-gold transition-all whitespace-nowrap cursor-pointer">All</button>
                <button type="button" onclick="filterModalCategory('OUTERWEAR')" class="category-filter-btn px-3 py-1 rounded-full text-xs font-bold bg-obsidian-elevated text-muted-silver hover:text-white border border-obsidian-border transition-all whitespace-nowrap cursor-pointer">🧥 Outerwear & Jackets</button>
                <button type="button" onclick="filterModalCategory('TOPS')" class="category-filter-btn px-3 py-1 rounded-full text-xs font-bold bg-obsidian-elevated text-muted-silver hover:text-white border border-obsidian-border transition-all whitespace-nowrap cursor-pointer">👕 Tops & Sweatshirts</button>
                <button type="button" onclick="filterModalCategory('BOTTOMS')" class="category-filter-btn px-3 py-1 rounded-full text-xs font-bold bg-obsidian-elevated text-muted-silver hover:text-white border border-obsidian-border transition-all whitespace-nowrap cursor-pointer">👖 Denims & Cargos</button>
                <button type="button" onclick="filterModalCategory('GIRLS')" class="category-filter-btn px-3 py-1 rounded-full text-xs font-bold bg-obsidian-elevated text-muted-silver hover:text-white border border-obsidian-border transition-all whitespace-nowrap cursor-pointer">✨ Girls Wear</button>
            </div>

            <!-- Scrollable Apparel Chips Grid -->
            <div id="modalPlentyChipsGrid" class="p-4 pt-1 overflow-y-auto flex-1 max-h-[46vh] space-y-2">
                <!-- Dynamically populated from APPAREL_CATALOG -->
            </div>

            <!-- Modal Footer with Dynamic Continue Button -->
            <div class="p-4 border-t border-obsidian-border bg-obsidian-elevated/70 flex items-center justify-between gap-3 flex-shrink-0">
                <button type="button" onclick="closeFocusModalAndExplore()" class="text-xs text-muted-silver hover:text-white underline cursor-pointer">
                    Skip review
                </button>
                <button type="button" id="btnModalConfirmContinue" onclick="confirmServicesAndCuratePage()" 
